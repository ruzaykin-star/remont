# Copy this file to .env.local for local development (vite reads .env.local automatically).
# For the deployed site, set the same three variables in Vercel: Project -> Settings -> Environment Variables.

# Supabase project URL and anon (public) key — find both in Supabase: Project Settings -> API.
VITE_SUPABASE_URL=https://svbwcqzieoquabzqjdlu.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Acts as a hard-to-guess "room name" for this project's data row — anyone who has
# this value (and the URL) can read/write the shared data. Generated once below;
# keep it the same everywhere so everyone lands on the same data.
VITE_PROJECT_ID=5e9e1aeb-a0fb-444c-b62f-b38d79d3bb50
